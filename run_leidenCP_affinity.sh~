#!/bin/bash

# A: 従来条件
unset OMP_PROC_BIND
unset OMP_PLACES

# B: core bind + close
#export OMP_PLACES=cores
#export OMP_PROC_BIND=close

# C: core bind + spread
#export OMP_PLACES=cores
#export OMP_PROC_BIND=spread

CMD="./bmciccg"
DATA_DIR="../0_florida"
BLOCK_DIR="../0_blocks/Leiden"

THREADS="32"

# Number of repetitions performed inside bmciccg
N=10

TOL="1.0e-8"
MIT="10000"

OUT_CSV="temp.csv"

# MATRICES="
# parabolic_fem
# apache2
# Emilia_923
# ecology2
# thermal2
# Geo_1438
# Hook_1498
# G3_circuit
# "
MATRICES="
parabolic_fem
Emilia_923
"

if [ ! -x "${CMD}" ]; then
    echo "ERROR: command not found or not executable: ${CMD}"
    exit 1
fi

if [ ! -d "${DATA_DIR}" ]; then
    echo "ERROR: DATA_DIR not found: ${DATA_DIR}"
    exit 1
fi

if [ ! -d "${BLOCK_DIR}" ]; then
    echo "ERROR: BLOCK_DIR not found: ${BLOCK_DIR}"
    exit 1
fi

echo "mat,nb,nc,thrd,cnv,time,iters,rel_resid,resid" > "${OUT_CSV}"

for mat in ${MATRICES}; do

    datafile="${DATA_DIR}/${mat}.mtx"

    if [ ! -f "${datafile}" ]; then
        echo "WARNING: matrix file not found: ${datafile}"
        continue
    fi

    BLK_FILE="${BLOCK_DIR}/${mat}_leiden_cpm_r0p001_c1.blk"
    BCOL_FILE="${BLOCK_DIR}/${mat}_leiden_cpm_r0p001_c1.bcol"

    if [ ! -f "${BLK_FILE}" ]; then
        echo "WARNING: blk file not found: ${BLK_FILE}"
        continue
    fi

    if [ ! -f "${BCOL_FILE}" ]; then
        echo "WARNING: bcol file not found: ${BCOL_FILE}"
        continue
    fi

    nb_val=$(head -n 1 "${BLK_FILE}")
    nc_val=$(head -n 1 "${BCOL_FILE}")

    for thrd in ${THREADS}; do

        export OMP_NUM_THREADS=${thrd}

        echo "========================================"
        echo "method   = ABMC"
        echo "matrix   = ${mat}"
        echo "nb       = ${nb_val}"
        echo "nc       = ${nc_val}"
        echo "threads  = ${thrd}"
        echo "repeat   = ${N}"
        echo "start    = $(date)"
        echo "========================================"

        "${CMD}" \
            "${datafile}" \
            "${BLK_FILE}" \
            "${BCOL_FILE}" \
            "${TOL}" \
            "${MIT}" \
            "${N}" |
        while IFS= read -r result; do
            [ -z "${result}" ] && continue
            echo "${mat},${nb_val},${nc_val},${thrd},${result}" \
                >> "${OUT_CSV}"
        done

        echo "end      = $(date)"
        echo
    done
done

echo "Results written to ${OUT_CSV}"
